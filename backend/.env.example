DATABASE_URL="postgresql://focusflow:focusflow@localhost:5432/focusflow"
JWT_SECRET="cambia-esto-por-un-secreto-seguro"
JWT_EXPIRES_IN_SEGUNDOS=604800
PORT=3000

# Sincronización con Google Calendar (opcional). Crea un proyecto en
# https://console.cloud.google.com, activa la "Google Calendar API", crea unas
# credenciales OAuth 2.0 de tipo "Aplicación web" y añade
# GOOGLE_REDIRECT_URI como URI de redirección autorizada. Sin estas variables
# la app funciona igual, simplemente sin el botón de Google Calendar activo.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/google/callback"
FRONTEND_URL="http://localhost:5173"

# Envío de correo para el consentimiento parental de menores de edad
# (opcional). Configura un SMTP real (por ejemplo una cuenta de Gmail con
# contraseña de aplicación, o un proveedor tipo Mailtrap/Resend en modo SMTP).
# Sin estas variables la app funciona igual: el registro de un menor se
# completa con normalidad, pero el correo de confirmación al tutor no llega
# hasta que se rellenen y se reenvíe manualmente desde la pantalla de "cuenta
# pendiente de confirmación".
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="FocusFlow <no-reply@focusflow.local>"

# Recordatorios y alarmas. El proceso programado (cada 5 minutos) usa esta zona
# horaria para decidir cuándo toca cada aviso (la revisión semanal a su hora,
# las entregas, las vacaciones).
ZONA_HORARIA="Europe/Madrid"

# Carpeta con los calendarios escolares (un JSON por curso, ver su LEEME.md).
# Opcional: por defecto datos/calendarios-escolares, relativa a la carpeta
# desde la que se arranca el backend.
# CALENDARIOS_ESCOLARES_DIR="datos/calendarios-escolares"

# IA del plan Plus (asistente de tareas y texto de los avisos). Solo la usan
# las cuentas con plan de pago (o un menor vinculado a una) y cada una tiene
# como mucho IA_LIMITE_MENSUAL usos del asistente al mes.
# - Con ANTHROPIC_API_KEY (https://console.anthropic.com), se usa Claude:
#   Haiku 4.5 para los avisos y Sonnet 5.5 para el asistente. Se paga por uso,
#   sin cuota: sin usuarios de pago, gasto cero.
# - Sin clave, se usa Ollama (abajo), para desarrollar en local sin gasto.
ANTHROPIC_API_KEY=""
# IA_MODELO_AVISOS="claude-haiku-4-5"
# IA_MODELO_ASISTENTE="claude-sonnet-5-5"
# ANTHROPIC_TIMEOUT_MS=60000
# IA_LIMITE_MENSUAL=100

# Cobro del plan Plus con Stripe (opcional). Sin STRIPE_SECRET_KEY la app
# funciona igual, solo que no se puede pagar (el plan se cambia a mano).
# - STRIPE_SECRET_KEY: mejor una clave restringida (rk_...) con permiso de
#   escritura en Customers, Checkout Sessions, Customer portal y Subscriptions.
#   En desarrollo, la de un sandbox (rk_test_... / sk_test_...).
# - STRIPE_WEBHOOK_SECRET: el "signing secret" (whsec_...) del webhook
#   https://<dominio>/api/pagos/webhook con los eventos checkout.session.completed
#   y customer.subscription.created/updated/deleted. En local lo da
#   `stripe listen --forward-to localhost:3000/pagos/webhook`.
# - STRIPE_PRECIO_*: los ID (price_...) de los dos precios del producto Plus
#   (3,99 €/mes y 29,99 €/año, IVA incluido).
# - OFERTA_PLUS_HASTA: oferta de lanzamiento (AAAA-MM-DD, incluido). Mientras
#   esté vigente, la ventana del Plus lo anuncia y Checkout deja poner un código
#   de promoción (créalo en Stripe con la misma fecha de fin y pon su nombre en
#   OFERTA_PLUS_CODIGO, que es el que se enseña). Vacío = sin oferta.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRECIO_MENSUAL=""
STRIPE_PRECIO_ANUAL=""
OFERTA_PLUS_HASTA=""
OFERTA_PLUS_CODIGO=""

# IA local (opcional) mediante Ollama (https://ollama.com), si no hay clave de
# Anthropic. Si OLLAMA_URL está vacía, Ollama no está arrancado o tarda más de
# OLLAMA_TIMEOUT_MS, los avisos se generan igual con su texto por reglas fijas.
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODELO="qwen3.5:2b"
OLLAMA_TIMEOUT_MS=90000
# Cuánto tiempo mantiene Ollama el modelo cargado entre peticiones (cargarlo
# en frío puede tardar más de un minuto).
OLLAMA_KEEP_ALIVE="30m"

# Web Push: avisos en el móvil o el ordenador aunque la app esté cerrada
# (opcional). Genera un par de claves con `npx web-push generate-vapid-keys`
# y no las cambies después: los dispositivos ya suscritos dejarían de recibir
# avisos. VAPID_SUBJECT es un contacto para el servicio de push del navegador
# (mailto: o una URL). Sin estas variables la app funciona igual, solo con los
# avisos dentro de la app abierta.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:tu-correo@ejemplo.com"
