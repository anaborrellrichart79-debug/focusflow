// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id               String            @id @default(uuid())
  correo           String            @unique
  contrasena       String
  nombre           String?
  objetivos        Objetivo[]
  tareas           Tarea[]
  sesionesPomodoro SesionPomodoro[]
  creadoEn         DateTime          @default(now())
  actualizadoEn    DateTime          @updatedAt

  @@map("usuarios")
}

model Objetivo {
  id            String   @id @default(uuid())
  titulo        String
  descripcion   String?
  usuarioId     String
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tareas        Tarea[]
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("objetivos")
}

enum EstadoTarea {
  POR_HACER
  EN_PROCESO
  HECHA
}

model Tarea {
  id               String           @id @default(uuid())
  titulo           String
  descripcion      String?
  estado           EstadoTarea      @default(POR_HACER)
  urgente          Boolean          @default(false)
  importante       Boolean          @default(false)
  esAltoImpacto    Boolean          @default(false)
  usuarioId        String
  usuario          Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  objetivoId       String?
  objetivo         Objetivo?        @relation(fields: [objetivoId], references: [id], onDelete: Cascade)
  sesionesPomodoro SesionPomodoro[]
  creadoEn         DateTime         @default(now())
  actualizadoEn    DateTime         @updatedAt

  @@map("tareas")
}

enum FasePomodoro {
  TRABAJO
  DESCANSO_CORTO
  DESCANSO_LARGO
}

// Registra cada fase de Pomodoro completada (no solo "trabajo") para poder
// mostrar más adelante estadísticas de descansos además de ciclos de trabajo.
// tareaId es opcional y se conserva el historial aunque se borre la tarea
// (onDelete: SetNull), a diferencia de Objetivo->Tarea que sí es en cascada.
model SesionPomodoro {
  id               String       @id @default(uuid())
  fase             FasePomodoro
  duracionSegundos Int
  usuarioId        String
  usuario          Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tareaId          String?
  tarea            Tarea?       @relation(fields: [tareaId], references: [id], onDelete: SetNull)
  completadaEn     DateTime     @default(now())

  @@map("sesiones_pomodoro")
}
