// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id                         String                   @id @default(uuid())
  correo                     String                   @unique
  contrasena                 String
  nombre                     String?
  objetivos                  Objetivo[]
  tareas                     Tarea[]
  sesionesPomodoro           SesionPomodoro[]
  etiquetas                  Etiqueta[]
  eventosGoogle              EventoCalendarioGoogle[]
  horarios                   Horario[]
  asignaturasPropias         Asignatura[]
  // Tokens de la cuenta de Google Calendar conectada (si la hay). Sin cifrar:
  // misma postura de seguridad que el resto del proyecto (JWT_SECRET en claro
  // en .env, sin cifrado adicional en la base de datos), aceptable para un
  // proyecto personal en desarrollo local, no para producción multiusuario.
  googleAccessToken          String?
  googleRefreshToken         String?
  googleTokenExpiraEn        DateTime?
  googleUltimaSincronizacion DateTime?
  // Modo escolar (planificador de exámenes/trabajos) y consentimiento de un
  // tutor legal para menores de edad. fechaNacimiento determina si hace falta
  // consentimiento (ver calcularEdad en comun/edad.util.ts); consentimientoConfirmado
  // por defecto en true para no bloquear retroactivamente a las cuentas ya
  // existentes, que no tienen fecha de nacimiento registrada.
  fechaNacimiento            DateTime?
  correoTutor                String?
  consentimientoConfirmado   Boolean                  @default(true)
  consentimientoReenviadoEn  DateTime?
  modoEscolarActivo          Boolean                  @default(false)
  creadoEn                   DateTime                 @default(now())
  actualizadoEn              DateTime                 @updatedAt

  @@map("usuarios")
}

model Objetivo {
  id            String    @id @default(uuid())
  titulo        String
  descripcion   String?
  fechaLimite   DateTime?
  // Independiente del ámbito de sus tareas (sin cascada automática entre
  // ambos): un objetivo escolar agrupa tareas escolares por convención de uso,
  // pero no se fuerza a nivel de datos.
  ambito        Ambito    @default(PERSONAL)
  usuarioId     String
  usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tareas        Tarea[]
  creadoEn      DateTime  @default(now())
  actualizadoEn DateTime  @updatedAt

  @@map("objetivos")
}

enum EstadoTarea {
  POR_HACER
  EN_PROCESO
  HECHA
}

enum Recurrencia {
  NINGUNA
  DIARIA
  SEMANAL
}

// Distingue tareas/objetivos personales o profesionales de los escolares, para
// poder filtrar la vista activa (selector de ámbito en el frontend) y no
// mezclar ambos mundos cuando el usuario no lo quiere.
enum Ambito {
  PERSONAL
  ESCOLAR
}

// Solo relevante cuando Tarea.ambito = ESCOLAR; no se fuerza con una
// constraint de base de datos (mismo criterio que duracionMinutos con
// fechaLimite), se valida en el DTO/frontend.
enum TipoEscolar {
  EXAMEN
  TRABAJO
  PRESENTACION
}

model Tarea {
  id                    String                  @id @default(uuid())
  titulo                String
  descripcion           String?
  estado                EstadoTarea             @default(POR_HACER)
  urgente               Boolean                 @default(false)
  importante            Boolean                 @default(false)
  esAltoImpacto         Boolean                 @default(false)
  fechaLimite           DateTime?
  // Duración en minutos de la tarea cuando fechaLimite lleva una hora de
  // inicio real (no medianoche): permite representarla como bloque de tiempo
  // en la Agenda y como evento con hora en Google Calendar en vez de "todo
  // el día". Null cuando no se ha indicado (se asumen 30 minutos en los
  // sitios que la consumen).
  duracionMinutos       Int?
  recurrencia           Recurrencia             @default(NINGUNA)
  tiempoEstimadoMinutos Int?
  ambito                Ambito                  @default(PERSONAL)
  tipoEscolar           TipoEscolar?
  usuarioId             String
  usuario               Usuario                 @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  objetivoId            String?
  objetivo              Objetivo?               @relation(fields: [objetivoId], references: [id], onDelete: Cascade)
  sesionesPomodoro      SesionPomodoro[]
  subtareas             Subtarea[]
  etiquetas             Etiqueta[]              @relation("TareaEtiquetas")
  eventoGoogle          EventoCalendarioGoogle?
  // Asignatura (de un horario concreto, con su color) a la que pertenece una
  // tarea escolar. SetNull: si se quita la asignatura del horario, la tarea
  // se conserva, solo pierde el enlace.
  asignaturaHorarioId   String?
  asignaturaHorario     AsignaturaHorario?      @relation(fields: [asignaturaHorarioId], references: [id], onDelete: SetNull)
  creadoEn              DateTime                @default(now())
  actualizadoEn         DateTime                @updatedAt

  @@map("tareas")
}

// Checklist dentro de una tarea, para tareas más grandes que un Pomodoro sin
// llegar a crear un objetivo nuevo. Solo título + completada: no necesita su
// propio estado Kanban ni prioridad, hereda el contexto de la tarea padre.
model Subtarea {
  id            String   @id @default(uuid())
  titulo        String
  completada    Boolean  @default(false)
  tareaId       String
  tarea         Tarea    @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("subtareas")
}

// Etiquetas libres por usuario (no por tarea): "nombre" es único por usuario
// para poder reutilizar la misma etiqueta en varias tareas vía connectOrCreate
// sin duplicados, y para poder ofrecer un listado de "mis etiquetas" en la UI.
model Etiqueta {
  id        String   @id @default(uuid())
  nombre    String
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tareas    Tarea[]  @relation("TareaEtiquetas")
  creadoEn  DateTime @default(now())

  @@unique([usuarioId, nombre])
  @@map("etiquetas")
}

enum FasePomodoro {
  TRABAJO
  DESCANSO_CORTO
  DESCANSO_LARGO
}

// Registra cada fase de Pomodoro completada (no solo "trabajo") para poder
// mostrar más adelante estadísticas de descansos además de ciclos de trabajo.
// tareaId es opcional y se conserva el historial aunque se borre la tarea
// (onDelete: SetNull), a diferencia de Objetivo->Tarea que sí es en cascada.
model SesionPomodoro {
  id               String                  @id @default(uuid())
  fase             FasePomodoro
  duracionSegundos Int
  usuarioId        String
  usuario          Usuario                 @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tareaId          String?
  tarea            Tarea?                  @relation(fields: [tareaId], references: [id], onDelete: SetNull)
  completadaEn     DateTime                @default(now())
  eventoGoogle     EventoCalendarioGoogle?

  @@map("sesiones_pomodoro")
}

// Lleva la cuenta de qué tarea/sesión de Pomodoro ya tiene su evento gemelo en
// Google Calendar, para no duplicarlo en cada sincronización y para saber a
// qué tarea traducir un evento que llega importado desde el calendario. Un
// evento de Google es de una cosa o de la otra, nunca de las dos a la vez.
model EventoCalendarioGoogle {
  id               String          @id @default(uuid())
  usuarioId        String
  usuario          Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  googleEventId    String
  tareaId          String?         @unique
  tarea            Tarea?          @relation(fields: [tareaId], references: [id], onDelete: Cascade)
  sesionPomodoroId String?         @unique
  sesionPomodoro   SesionPomodoro? @relation(fields: [sesionPomodoroId], references: [id], onDelete: Cascade)
  actualizadoEn    DateTime        @updatedAt

  @@unique([usuarioId, googleEventId])
  @@map("eventos_calendario_google")
}

// ---------------------------------------------------------------------------
// Horario de clase y catálogo de asignaturas (LOMLOE)
// ---------------------------------------------------------------------------

enum Etapa {
  PRIMARIA
  ESO
  BACHILLERATO
}

// OBLIGATORIA: común a todo el alumnado del curso. DE_OPCION: materias entre
// las que se elige (4º de ESO, materias de modalidad de Bachillerato).
// OPTATIVA: oferta complementaria (segunda lengua extranjera, religión...).
// AUTONOMICA: lengua propia de una comunidad autónoma (ver `comunidad`).
enum CategoriaAsignatura {
  OBLIGATORIA
  DE_OPCION
  OPTATIVA
  AUTONOMICA
}

enum ComunidadAutonoma {
  ANDALUCIA
  ARAGON
  ASTURIAS
  BALEARES
  CANARIAS
  CANTABRIA
  CASTILLA_LA_MANCHA
  CASTILLA_Y_LEON
  CATALUNA
  COMUNITAT_VALENCIANA
  EXTREMADURA
  GALICIA
  MADRID
  MURCIA
  NAVARRA
  PAIS_VASCO
  LA_RIOJA
  CEUTA
  MELILLA
}

enum TipoFranja {
  CLASE
  DESCANSO
}

// Catálogo fijo de cursos, cargado al arrancar el backend desde
// src/horarios/catalogo-lomloe.ts (ids legibles y estables, p. ej. "eso-3").
model Curso {
  id          String       @id
  etapa       Etapa
  numero      Int
  nombre      String
  asignaturas Asignatura[]
  horarios    Horario[]

  @@map("cursos")
}

// Asignatura oficial del catálogo (usuarioId null, id fijo como
// "eso-3-matematicas") u optativa añadida por un usuario (usuarioId suyo,
// id uuid). `comunidad` solo se usa en las lenguas propias de cada comunidad
// autónoma, para ofrecer a cada horario solo la de su comunidad.
model Asignatura {
  id         String              @id @default(uuid())
  nombre     String
  categoria  CategoriaAsignatura
  modalidad  String?
  comunidad  ComunidadAutonoma?
  cursoId    String
  curso      Curso               @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  usuarioId  String?
  usuario    Usuario?            @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  enHorarios AsignaturaHorario[]
  creadoEn   DateTime            @default(now())

  @@index([cursoId])
  @@map("asignaturas")
}

// Un usuario puede tener varios horarios (uno por curso/periodo) y solo uno
// activo, que es el que se muestra en la Agenda.
model Horario {
  id            String              @id @default(uuid())
  titulo        String
  periodo       String
  activo        Boolean             @default(false)
  comunidad     ComunidadAutonoma
  cursoId       String
  curso         Curso               @relation(fields: [cursoId], references: [id])
  usuarioId     String
  usuario       Usuario             @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  franjas       FranjaHorario[]
  asignaturas   AsignaturaHorario[]
  sesiones      SesionClase[]
  creadoEn      DateTime            @default(now())
  actualizadoEn DateTime            @updatedAt

  @@map("horarios")
}

// Fila de la cuadrícula. Las horas se guardan como texto "HH:mm" (hora de
// reloj, sin fecha ni zona horaria): se repiten igual todas las semanas.
model FranjaHorario {
  id         String        @id @default(uuid())
  orden      Int
  horaInicio String
  horaFin    String
  tipo       TipoFranja    @default(CLASE)
  etiqueta   String?
  horarioId  String
  horario    Horario       @relation(fields: [horarioId], references: [id], onDelete: Cascade)
  sesiones   SesionClase[]

  @@map("franjas_horario")
}

// Asignatura elegida para un horario concreto, con el color con que se pinta.
model AsignaturaHorario {
  id           String        @id @default(uuid())
  color        String
  horarioId    String
  horario      Horario       @relation(fields: [horarioId], references: [id], onDelete: Cascade)
  asignaturaId String
  asignatura   Asignatura    @relation(fields: [asignaturaId], references: [id], onDelete: Cascade)
  sesiones     SesionClase[]
  tareas       Tarea[]
  creadoEn     DateTime      @default(now())

  @@unique([horarioId, asignaturaId])
  @@map("asignaturas_horario")
}

// Celda de la cuadrícula: qué asignatura hay en una franja un día de la semana
// (1 = lunes ... 5 = viernes). Una celda vacía simplemente no tiene fila.
model SesionClase {
  id                  String            @id @default(uuid())
  diaSemana           Int
  aula                String?
  horarioId           String
  horario             Horario           @relation(fields: [horarioId], references: [id], onDelete: Cascade)
  franjaId            String
  franja              FranjaHorario     @relation(fields: [franjaId], references: [id], onDelete: Cascade)
  asignaturaHorarioId String
  asignaturaHorario   AsignaturaHorario @relation(fields: [asignaturaHorarioId], references: [id], onDelete: Cascade)

  @@unique([franjaId, diaSemana])
  @@map("sesiones_clase")
}
